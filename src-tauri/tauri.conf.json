{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sorakada",
  "version": "0.1.0-alpha.1",
  "identifier": "com.sorakada.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sorakada",
        "width": 1200,
        "height": 780,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "text",
          "log",
          "md",
          "markdown",
          "json",
          "jsonc",
          "xml",
          "yaml",
          "yml",
          "ini",
          "cfg",
          "conf",
          "properties",
          "toml",
          "csv",
          "c",
          "h",
          "cpp",
          "hpp",
          "java",
          "kt",
          "rs",
          "go",
          "py",
          "js",
          "jsx",
          "ts",
          "tsx",
          "html",
          "css",
          "scss",
          "sql",
          "sh",
          "bat",
          "cmd",
          "ps1"
        ],
        "name": "Sorakada.Text.1",
        "description": "Sorakada text, code, and configuration file"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/file-associations.nsh"
      }
    }
  }
}
